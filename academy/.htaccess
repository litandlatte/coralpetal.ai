# academy.coralpetal.ai — Apache rules for Hostinger. This folder sits inside the main
# docroot but is its own site: a sub-folder .htaccess does NOT inherit the parent's
# rewrite rules, so everything the academy needs is here.
# HTTPS is forced by Hostinger (hPanel), not here (the CDN terminates TLS).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# BEGIN course short links (generated by scripts/build_academy_courses.py, do not edit by hand)
<IfModule mod_alias.c>
  RedirectMatch 302 ^/statistics/statistics-fundamental/tutorial/?$ /login/?course=statistics-fundamental
